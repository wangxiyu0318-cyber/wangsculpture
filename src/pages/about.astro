---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Artwork from "../components/Artwork.astro";
import { projects } from "../data/projects";
import { biography, statement } from "../data/site";
---

<Layout title="About" active="About">
  <section class="about-page page-gutter" id="top">
    <div class="page-heading">
      <span class="eyebrow">The artist / The practice</span>
      <h1>About</h1>
    </div>
    <div class="about-lead">
      <h2>
        A dialogue between
        <br />
        material and form.
      </h2>
      <div>
        <p>{biography}</p>
        <span class="eyebrow">Based in Tokyo, Japan</span>
      </div>
    </div>
    <figure class="about-image">
      <Artwork
        image={projects[2].images[0]}
        eager
        sizes="(max-width: 700px) 100vw, 90vw"
      />
      <figcaption>Material study · Placeholder artwork</figcaption>
    </figure>
    <div class="statement-row">
      <h2 class="eyebrow">Artist statement</h2>
      <div>
        <p class="statement">{statement}</p>
        <p class="sample-note">
          Working statement · To be reviewed by the artist
        </p>
        <a href="/cv/" class="text-link">
          CV & exhibitions <Arrow />
        </a>
      </div>
    </div>
  </section>
</Layout>
