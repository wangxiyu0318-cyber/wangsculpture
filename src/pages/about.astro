---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Artwork from "../components/Artwork.astro";
import { biography, statement } from "../data/site";
---

<Layout title="About" active="About">
  <section class="about-page page-gutter" id="top">
    <div class="page-heading">
      <span class="eyebrow">The artist / The practice</span>
      <h1>About</h1>
    </div>
    <div class="about-lead">
      <div class="about-biography">
        <h2>Xiyu Wang</h2>
        {(biography || "Biography to be added.").split("\n\n").map((paragraph) => (
          <p class:list={{ muted: !biography }}>{paragraph}</p>
        ))}
        <span class="eyebrow">Based in Tokyo, Japan</span>
      </div>
      <figure class="about-image">
      <Artwork
        image={{
          src: "about-xiyu-wang",
          alt: "Xiyu Wang",
          caption: "",
          width: 2400,
          height: 3200,
        }}
        sizes="(max-width: 700px) min(320px, calc(100vw - 48px)), 360px"
      />
      </figure>
    </div>
    {statement.trim() && (
    <div class="statement-row">
      <h2 class="eyebrow">Artist statement</h2>
      <div>
        <p class:list={["statement", { muted: !statement }]}>
          {statement || "Artist statement to be added."}
        </p>
        <a href={import.meta.env.BASE_URL + "cv/"} class="text-link">
          CV & exhibitions <Arrow />
        </a>
      </div>
    </div>
    )}
  </section>
</Layout>

<style>
  .about-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    gap: clamp(40px, 7vw, 100px);
    max-width: 1100px;
    padding-bottom: 0;
    align-items: start;
  }
  .about-biography h2 {
    margin-bottom: 32px;
  }
  .about-biography p + p {
    margin-top: 20px;
  }
  .about-image {
    width: 100%;
    max-width: 360px;
    margin: 0;
  }
  .about-image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    object-position: center;
  }
  @media (max-width: 700px) {
    .about-lead {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .about-image {
      max-width: 320px;
    }
  }
  @media (max-width: 430px) {
    .about-lead > .about-biography > .eyebrow {
      font-size: 12px;
    }
    .about-lead > .about-biography > p {
      font-size: 16px;
      line-height: 1.8;
    }
  }
</style>
