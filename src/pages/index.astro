---
import Layout from "../layouts/Layout.astro";
import Artwork from "../components/Artwork.astro";
import ArtworkPlaceholder from "../components/ArtworkPlaceholder.astro";
import WorkItem from "../components/WorkItem.astro";
import Arrow from "../components/Arrow.astro";
import { projects, projectPeriod } from "../data/projects";
const hero = projects[0];
const total = String(projects.length).padStart(2, "0");
---

<Layout>
  <section
    class="home-intro page-gutter"
    id="top"
    aria-labelledby="artist-name"
  >
    <div class="home-heading">
      <h1 id="artist-name">XIYU WANG</h1>
      <div class="home-location">
        <span>Sculptor</span>
        <span>
          Tokyo, Japan <span class="location-point" aria-hidden="true"></span>
        </span>
      </div>
    </div>
    <a
      class="hero-artwork"
      href={`/works/${hero.slug}/`}
      aria-label={`View ${hero.title}`}
    >
      {hero.images[0] ? (
        <Artwork
          image={hero.images[0]}
          class={hero.slug === "somira" ? "somira-cover" : undefined}
          eager
          sizes="(max-width: 700px) 100vw, calc(100vw - 96px)"
        />
      ) : (
        <ArtworkPlaceholder title={hero.title} format="hero" />
      )}
      <span class="hero-view">
        Explore the work <Arrow direction="diagonal" />
      </span>
    </a>
    <div class="hero-caption">
      <div>
        <span class="caption-index">01 / {total}</span>
        <span>
          {hero.title}
          {hero.year && `, ${hero.year}`}
        </span>
      </div>
      {hero.materials && <span class="hero-material">{hero.materials}</span>}
      <a href="#selected-works" class="explore-link">
        Scroll to explore <Arrow direction="down" />
      </a>
    </div>
  </section>
  <section
    class="selected-section page-gutter"
    id="selected-works"
    aria-labelledby="selected-heading"
  >
    <div class="section-heading">
      <h2 id="selected-heading">
        Selected works <span class="count">(03)</span>
      </h2>
      <span class="section-years">{projectPeriod}</span>
      <a class="text-link" href="/works/">
        View all works <Arrow />
      </a>
    </div>
    <div class="selected-grid">
      <WorkItem
        project={projects[1]}
        number="02"
        class="selected-one"
        format="portrait"
      />
      <WorkItem project={projects[2]} number="03" class="selected-two" />
      <WorkItem project={projects[3]} number="04" class="selected-three" />
    </div>
  </section>
  <section class="home-about page-gutter">
    <span class="eyebrow">The artist</span>
    <div>
      <h2>Xiyu Wang</h2>
      <p>Sculptor based in Tokyo, Japan.</p>
      <a href="/about/" class="text-link">
        About the artist <Arrow />
      </a>
    </div>
  </section>
</Layout>
