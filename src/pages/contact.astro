---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import { site } from "../data/site";
---

<Layout title="Contact" active="Contact">
  <section class="contact-page page-gutter" id="top">
    <div class="page-heading">
      <span class="eyebrow">Conversations / Enquiries</span>
      <h1>Get in touch.</h1>
      <p>For exhibitions, collaborations and studio enquiries.</p>
    </div>
    <div class="contact-content">
      <div class="contact-location">
        <span class="location-point" aria-hidden="true"></span>
        <p>
          Tokyo, Japan
          <br />
          <span class="muted">Available for conversations worldwide.</span>
        </p>
      </div>
      <div class="contact-links">
        <div class="contact-row">
          <span class="eyebrow">Email</span>
          {site.email ? (
            <a href={`mailto:${site.email}`}>
              {site.email}
              <Arrow direction="diagonal" />
            </a>
          ) : (
            <div class="email-pending">
              <span>Email to be added</span>
              <p>In the meantime, please get in touch via Instagram.</p>
            </div>
          )}
        </div>
        <div class="contact-row">
          <span class="eyebrow">Instagram</span>
          <a
            href={`https://www.instagram.com/${site.instagram}/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            @{site.instagram}
            <Arrow direction="diagonal" />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
    <div class="contact-signoff">
      <span>Material. Form. Presence.</span>
      <span>XIYU WANG</span>
    </div>
  </section>
</Layout>
