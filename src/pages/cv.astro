---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import { cv } from "../data/site";
---

<Layout title="CV & Exhibitions" active="CV">
  <section class="cv-page page-gutter" id="top">
    <div class="page-heading">
      <span class="eyebrow">Xiyu Wang / Curriculum vitae</span>
      <h1>CV & Exhibitions</h1>
    </div>
    <div class="cv-intro">
      <span class="eyebrow">Sculptor</span>
      <p>
        Based in Tokyo, Japan
        <br />
        <span class="muted">Wood, metal, enamel, paper & mixed materials</span>
      </p>
    </div>
    {cv.map((section) => (
      <section class="cv-section">
        <h2>{section.heading}</h2>
        <div>
          {[...new Set(section.entries.map((entry) => entry.year))].map((year) => (
            <div class="cv-entry">
              <span>{year}</span>
              <div class="cv-year-entries">
                {section.entries.filter((entry) => entry.year === year).map((entry) => (
                  <div>
                    {entry.upcoming && <span class="eyebrow cv-upcoming">Upcoming</span>}
                    <h3>{entry.title}</h3>
                    <p>{entry.place}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
    <div class="cv-contact">
      <a class="text-link" href={import.meta.env.BASE_URL + "contact/"}>
        Get in touch <Arrow />
      </a>
    </div>
  </section>
</Layout>

<style>
  .cv-year-entries {
    display: grid;
    gap: 24px;
  }
  .cv-upcoming {
    display: block;
    margin-bottom: 6px;
  }
</style>
