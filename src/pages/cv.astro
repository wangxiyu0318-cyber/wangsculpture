---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import { cv } from "../data/site";
---

<Layout title="CV & Exhibitions" active="CV">
  <section class="cv-page page-gutter" id="top">
    <div class="page-heading">
      <span class="eyebrow">Xiyu Wang / Curriculum vitae</span>
      <h1>CV & Exhibitions</h1>
      <p>A record of exhibitions, residencies and professional practice.</p>
    </div>
    <div class="cv-intro">
      <span class="eyebrow">Sculptor</span>
      <p>
        Based in Tokyo, Japan
        <br />
        <span class="muted">Wood, metal, enamel, paper & mixed materials</span>
      </p>
    </div>
    {cv.map((section) => (
      <section class="cv-section">
        <h2>{section.heading}</h2>
        <div>
          {section.entries.length ? (
            section.entries.map((entry) => (
              <div class="cv-entry">
                <span>{entry.year}</span>
                <div>
                  <h3>{entry.title}</h3>
                  <p>{entry.place}</p>
                </div>
              </div>
            ))
          ) : (
            <p class="cv-empty">Details to be added.</p>
          )}
        </div>
      </section>
    ))}
    <div class="cv-contact">
      <p>For a full CV or further information</p>
      <a class="text-link" href="/contact/">
        Get in touch <Arrow />
      </a>
    </div>
  </section>
</Layout>
