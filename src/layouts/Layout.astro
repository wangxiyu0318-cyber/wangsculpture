---
import "../styles/global.css";
import { getLanguage, translator, localizedHref, routePath } from "../i18n";
import { projects, getProjects } from "../data/projects";
import { homeDescription } from "../lib/seo";
const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const path = routePath(Astro.url);
const equivalentPages = new Set(["", "works", "about", "cv", "contact", ...projects.map((project) => `works/${project.slug}`)]);
const equivalentPath = equivalentPages.has(path) ? path : "";
const englishHref = localizedHref("en", equivalentPath);
const chineseHref = localizedHref("zh", equivalentPath);
import { site } from "../data/site";
import Arrow from "../components/Arrow.astro";
import ArtistLogo from "../components/ArtistLogo.astro";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = homeDescription,
  active = "",
  image,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} | Xiyu Wang`
  : "Xiyu Wang | Sculptor & Artist";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const artwork = getProjects(language).find((project) => path === `works/${project.slug}`);
const sharingImage = image ?? `${import.meta.env.BASE_URL}images/${projects[0].images[0].src}.webp`;
const socialImage = Astro.site ? new URL(sharingImage, Astro.site).href : undefined;
const socialImageAlt = artwork?.images[0]?.alt ?? projects[0].images[0].alt;
const artistId = new URL("/#artist", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const nav = [
  { label: "Works", href: href("works/") },
  { label: "About", href: href("about/") },
  { label: "CV", href: href("cv/") },
  { label: "Contact", href: href("contact/") },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": artistId,
      name: site.name,
      url: Astro.site?.href,
      jobTitle: ["Sculptor", "Artist"],
      description: site.description,
      sameAs: [`https://www.instagram.com/${site.instagram}/`],
      workLocation: { "@type": "Place", name: site.location },
    },
    {
      "@type": "WebSite", "@id": websiteId,
      url: Astro.site?.href, name: "Xiyu Wang",
      publisher: { "@id": artistId },
    },
    ...(!noindex ? [{
      "@type": path === "about" ? "AboutPage" : path === "contact" ? "ContactPage" : path === "works" ? "CollectionPage" : "WebPage",
      "@id": `${canonical}#webpage`, url: canonical?.href,
      name: pageTitle, description,
      inLanguage: language === "zh" ? "zh-CN" : "en",
      isPartOf: { "@id": websiteId },
      about: { "@id": artistId },
      ...(artwork ? { mainEntity: { "@id": `${canonical}#artwork` } } : {}),
    }] : []),
    ...(artwork ? [{
      "@type": "VisualArtwork", "@id": `${canonical}#artwork`,
      name: artwork.title, url: canonical?.href,
      creator: { "@id": artistId },
      artform: "Sculpture", artMedium: artwork.materials,
      dateCreated: artwork.year, description,
      image: artwork.images.map((image) => ({
        "@type": "ImageObject",
        contentUrl: new URL(`${import.meta.env.BASE_URL}images/${image.src}.webp`, Astro.site).href,
        caption: image.alt, creator: { "@id": artistId },
        width: image.width, height: image.height,
      })),
      mainEntityOfPage: { "@id": `${canonical}#webpage` },
    }] : []),
  ],
};
---

<!doctype html>
<html lang={language === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xiyu Wang" />
    <meta property="og:locale" content={language === "zh" ? "zh_CN" : "en_US"} />
    {socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && equivalentPages.has(path) && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(englishHref, Astro.site)} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(chineseHref, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(englishHref, Astro.site)} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t("Skip to content")}
    </a>
    <header class="site-header signature-header page-gutter">
      <a href={href()} class="wordmark" aria-label={t("Xiyu Wang home")}>
        <ArtistLogo class="header-logo" />
        XIYU WANG
      </a>
      <div class="header-navigation-group">
      <button
        class="menu-toggle"
        data-menu-label={t("Menu")}
        data-close-label={t("Close")}
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t("Menu")}
        type="button"
      >
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
      </button>
      <div id="site-menu" class="navigation-panel" style={`--menu-last-index: ${nav.length + 1}`} aria-hidden="true" inert hidden>
      <nav
        id="main-navigation"
        class="main-navigation"
        aria-label={t("Main navigation")}
      >
        {nav.map((item, index) => (
          <a
            href={item.href}
            style={`--menu-index: ${index}`}
            aria-current={active === item.label ? "page" : undefined}
          >
            {t(item.label)}
          </a>
        ))}
      </nav>
      <div class="language-switcher" role="group" aria-label={t("Language")}>
        <a style={`--menu-index: ${nav.length}`} href={englishHref} lang="en" hreflang="en" aria-current={language === "en" ? "true" : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a style={`--menu-index: ${nav.length + 1}`} href={chineseHref} lang="zh-CN" hreflang="zh-CN" aria-current={language === "zh" ? "true" : undefined}>中文</a>
      </div>
      </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer page-gutter">
      <a class="footer-name" href={href()}>
        <ArtistLogo class="footer-logo" loading="lazy" />
        XIYU WANG<span>{t("Sculptor")}, Tokyo</span>
      </a>
      <span class="copyright">© {new Date().getFullYear()} Xiyu Wang</span>
      <a
        class="footer-instagram"
        href={`https://www.instagram.com/${site.instagram}/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram <Arrow direction="diagonal" />
        <span class="sr-only"> {t("(opens in a new tab)")}</span>
      </a>
      <a class="back-top" href="#top" aria-label={t("Back to top")}>
        <Arrow direction="down" />
      </a>
    </footer>
    <script>
      import { initializeSiteMenu } from "../scripts/site-menu";
      initializeSiteMenu();
      document
        .querySelector(".back-top")
        ?.addEventListener("click", (event) => {
          event.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "instant"
              : "smooth",
          });
        });
    </script>
  </body>
</html>


<style>
  .signature-header {
    --signature-height: 120px;
    height: var(--signature-height);
    display: block;
    position: relative;
    z-index: 20;
    background: #fff;
    border: 0;
    box-shadow: none;
  }
  .signature-header .wordmark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .signature-header :global(.artist-logo.header-logo) {
    width: 72px;
    height: 42px;
    object-fit: contain;
  }
  .signature-header .menu-toggle {
    position: absolute;
    top: 50%;
    left: auto;
    right: var(--gutter);
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
    margin: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .signature-header .menu-icon {
    position: relative;
    display: block;
    width: 24px;
    height: 16px;
  }
  .signature-header .menu-icon i {
    position: absolute;
    left: auto;
    right: 0;
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease), top 0.25s var(--ease), opacity 0.2s ease-out;
    transform: none;
  }
  .signature-header .menu-icon i:nth-child(1) { top: 0; }
  .signature-header .menu-icon i:nth-child(2) { top: 7px; }
  .signature-header .menu-icon i:nth-child(3) { top: 14px; }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(2) {
    opacity: 0;
  }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }
  .signature-header .navigation-panel {
    position: absolute;
    top: calc(50% - 22px);
    left: auto;
    right: calc(var(--gutter) + 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    transform-origin: top right;
    gap: 2px;
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter));
    transform: none;
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
    pointer-events: none;
  }
  .signature-header .navigation-panel[hidden] { display: none; }
  .signature-header .main-navigation {
    position: static;
    display: flex;
    left: auto;
    right: 0;
    top: auto;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    text-align: right;
    transform-origin: top right;
    gap: clamp(28px, 2vw, 36px);
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
  }
  .signature-header .main-navigation > a {
    min-height: 44px;
    justify-content: flex-end;
    font-size: 18px;
    text-transform: none;
    font-weight: 400;
    letter-spacing: normal;
    white-space: nowrap;
  }
  .signature-header .main-navigation a::after { display: none; }
  .signature-header .main-navigation a:hover,
  .signature-header .main-navigation a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .signature-header .language-switcher {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.4;
  }
  .signature-header .language-switcher [aria-current] {
    color: var(--ink);
    text-decoration: none;
  }
  .signature-header .language-switcher a:hover {
    color: var(--ink);
  }
  .signature-header .language-switcher a { min-width: 0; min-height: 28px; justify-content: center; }
  .signature-header .navigation-panel a,
  .signature-header .language-switcher > span {
    opacity: 0;
    transform: translateX(18px);
    transition: opacity 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
      transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
    transition-delay: calc(var(--menu-index, 4) * 0.04s);
  }
  .signature-header.is-menu-open .navigation-panel a,
  .signature-header.is-menu-open .language-switcher > span {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc((var(--menu-last-index) - var(--menu-index, 4)) * 0.04s);
  }
  .signature-header.is-menu-open .navigation-panel a { pointer-events: auto; }
  .signature-header .menu-toggle:focus-visible,
  .signature-header a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .header-navigation-group { display: contents; }
  @media (min-width: 701px) {
    .signature-header {
      --signature-height: 100px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content minmax(max-content, 1fr);
      grid-template-rows: 1fr;
      align-items: center;
      gap: 0;
    }
    .signature-header .wordmark {
      position: static;
      grid-column: 2;
      grid-row: 1;
      top: auto;
      left: auto;
      transform: none;
      justify-self: center;
      font-size: clamp(36px, 3vw, 42px);
      font-weight: 350;
    }
    .signature-header .header-navigation-group {
      display: grid;
      grid-column: 3;
      grid-row: 1;
      grid-template-columns: max-content 48px;
      grid-template-rows: 48px;
      align-items: center;
      column-gap: clamp(16px, 2.5vw, 32px);
      justify-self: end;
      width: max-content;
      margin-left: 70px;
    }
    .signature-header .menu-toggle {
      position: static;
      grid-column: 2;
      grid-row: 1;
      top: auto;
      right: auto;
      transform: none;
    }
    .signature-header .navigation-panel {
      position: relative;
      grid-column: 1;
      grid-row: 1;
      top: auto;
      right: auto;
      max-width: none;
      flex-direction: row;
      align-items: center;
      text-align: right;
      gap: clamp(12px, 1.6vw, 24px);
    }
    /* Reserve the same space while closed, so disclosure never moves the brand.
       The existing inert and aria-hidden states keep these links inaccessible. */
    .signature-header .navigation-panel[hidden] {
      display: flex !important;
      visibility: hidden;
    }
    .signature-header .main-navigation {
      justify-content: flex-end;
      gap: clamp(12px, calc(4.2vw - 18px), 40px);
    }
    .signature-header .main-navigation > a {
      min-height: 44px;
      font-size: clamp(17px, 1.4vw, 19px);
      font-weight: 575;
      line-height: 1.4;
    }
    .signature-header .language-switcher {
      position: static;
      flex-shrink: 0;
      width: max-content;
      font-size: 13px;
    }
    .signature-header .language-switcher a { min-height: 44px; }
  }
  @media (min-width: 701px) and (max-width: 800px) {
    .signature-header .wordmark { gap: 8px; }
    .signature-header .header-navigation-group {
      margin-left: 20px;
      column-gap: 12px;
    }
    .signature-header .main-navigation { gap: 8px; }
    .signature-header .navigation-panel { gap: 12px; }
  }
  @media (max-width: 700px) {
    .signature-header { --signature-height: 84px; z-index: 1000; }
    .signature-header .wordmark { font-size: 18px; gap: 10px; }
    .signature-header :global(.artist-logo.header-logo) { width: 48px; height: 28px; }
    .signature-header .menu-toggle {
      position: fixed;
      z-index: 101;
      color: #111;
      top: 20px;
      left: auto;
      right: var(--gutter);
      transform: none;
      width: 44px;
      height: 44px;
      min-height: 44px;
    }
    .signature-header .navigation-panel {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 100;
      width: 100vw;
      max-width: none;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      padding: 70px 28px;
      justify-content: safe center;
      align-items: center;
      text-align: center;
      background: rgba(255, 255, 255, 0);
      color: #111;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow-y: auto;
      overflow-x: hidden;
      gap: 20px;
      /* Fade only the white backdrop; keep link opacity independent. */
      opacity: 1;
      transform: none;
      transition: background-color 0.3s ease;
    }
    .signature-header.is-menu-open .navigation-panel {
      opacity: 1;
      background: rgba(255, 255, 255, 0.70);
      transform: none;
      pointer-events: auto;
    }
    .signature-header .main-navigation {
      flex-direction: column;
      flex-shrink: 0;
      align-items: center;
      text-align: center;
      gap: 18px;
    }
    .signature-header .main-navigation > a {
      font-size: 28px;
      justify-content: center;
      line-height: 1.3;
      min-height: 36px;
    }
    .signature-header .language-switcher,
    .signature-header .language-switcher [aria-current],
    .signature-header .navigation-panel a {
      color: #111;
    }
    .signature-header .language-switcher {
      font-size: 14px;
      flex-shrink: 0;
      justify-content: center;
    }
    .signature-header .language-switcher a { min-height: 36px; }
    .signature-header .navigation-panel a,
    .signature-header .language-switcher > span,
    .signature-header.is-menu-open .navigation-panel a,
    .signature-header.is-menu-open .language-switcher > span {
      opacity: 0;
      transform: none;
      transition: opacity 0.25s ease;
      transition-delay: 0s;
    }
    .signature-header.is-menu-open .navigation-panel a,
    .signature-header.is-menu-open .language-switcher > span {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .signature-header .navigation-panel,
    .signature-header .navigation-panel a,
    .signature-header .language-switcher > span,
    .signature-header .menu-icon i {
      transition: none;
    }
  }
  @media (max-width: 360px) {
    .signature-header .wordmark { font-size: 17px; gap: 8px; }
    .signature-header :global(.artist-logo.header-logo) { width: auto; height: 26px; }
  }
</style>
