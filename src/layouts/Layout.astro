---
import "../styles/global.css";
import { getLanguage, translator, localizedHref, routePath } from "../i18n";
import { projects } from "../data/projects";
const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const path = routePath(Astro.url);
const equivalentPages = new Set(["", "works", "about", "cv", "contact", ...projects.map((project) => `works/${project.slug}`)]);
const equivalentPath = equivalentPages.has(path) ? path : "";
const englishHref = localizedHref("en", equivalentPath);
const chineseHref = localizedHref("zh", equivalentPath);
import { site } from "../data/site";
import Arrow from "../components/Arrow.astro";
import ArtistLogo from "../components/ArtistLogo.astro";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
}
const {
  title,
  description = site.description,
  active = "",
  image,
} = Astro.props;
const pageTitle = title
  ? `${title} — Xiyu Wang`
  : "Xiyu Wang — Sculptor, Tokyo";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage =
  image && Astro.site ? new URL(image, Astro.site).href : image;
const nav = [
  { label: "Works", href: href("works/") },
  { label: "About", href: href("about/") },
  { label: "CV", href: href("cv/") },
  { label: "Contact", href: href("contact/") },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: site.description,
  sameAs: [`https://www.instagram.com/${site.instagram}/`],
  workLocation: { "@type": "Place", name: "Tokyo, Japan" },
};
---

<!doctype html>
<html lang={language === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && equivalentPages.has(path) && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(englishHref, Astro.site)} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(chineseHref, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(englishHref, Astro.site)} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t("Skip to content")}
    </a>
    <header class="site-header page-gutter">
      <a href={href()} class="wordmark" aria-label={t("Xiyu Wang home")}>
        <ArtistLogo class="header-logo" />
        XIYU WANG
      </a>
      <button
        class="menu-toggle"
        data-menu-label={t("Menu")}
        data-close-label={t("Close")}
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <span class="menu-label">{t("Menu")}</span>
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
      <nav
        id="main-navigation"
        class="main-navigation"
        aria-label={t("Main navigation")}
      >
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.label ? "page" : undefined}
          >
            {t(item.label)}
            <span class="nav-dot" aria-hidden="true"></span>
          </a>
        ))}
      </nav>
      <div class="language-switcher" role="group" aria-label={t("Language")}>
        <a href={englishHref} lang="en" hreflang="en" aria-current={language === "en" ? "true" : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href={chineseHref} lang="zh-CN" hreflang="zh-CN" aria-current={language === "zh" ? "true" : undefined}>中文</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer page-gutter">
      <a class="footer-name" href={href()}>
        <ArtistLogo class="footer-logo" loading="lazy" />
        XIYU WANG<span>{t("Sculptor")}, Tokyo</span>
      </a>
      <span class="copyright">© {new Date().getFullYear()} Xiyu Wang</span>
      <a
        class="footer-instagram"
        href={`https://www.instagram.com/${site.instagram}/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram <Arrow direction="diagonal" />
        <span class="sr-only"> {t("(opens in a new tab)")}</span>
      </a>
      <a class="back-top" href="#top" aria-label={t("Back to top")}>
        <Arrow direction="down" />
      </a>
    </footer>
    <script>
      const menuButton =
        document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation =
        document.querySelector<HTMLElement>(".main-navigation");
      function closeMenu() {
        menuButton?.setAttribute("aria-expanded", "false");
        navigation?.classList.remove("is-open");
        const label = menuButton?.querySelector(".menu-label");
        if (label) label.textContent = menuButton?.dataset.menuLabel ?? "Menu";
      }
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(open));
        navigation?.classList.toggle("is-open", open);
        const label = menuButton.querySelector(".menu-label");
        if (label) label.textContent = open ? menuButton.dataset.closeLabel ?? "Close" : menuButton.dataset.menuLabel ?? "Menu";
      });
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          menuButton?.getAttribute("aria-expanded") === "true"
        ) {
          closeMenu();
          menuButton.focus();
        }
      });
      window
        .matchMedia("(min-width: 701px)")
        .addEventListener("change", closeMenu);
      document
        .querySelector(".back-top")
        ?.addEventListener("click", (event) => {
          event.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "instant"
              : "smooth",
          });
        });
    </script>
  </body>
</html>
