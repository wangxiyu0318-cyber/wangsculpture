---
import "../styles/global.css";
import { getLanguage, translator, localizedHref, routePath } from "../i18n";
import { projects } from "../data/projects";
const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const path = routePath(Astro.url);
const equivalentPages = new Set(["", "works", "about", "cv", "contact", ...projects.map((project) => `works/${project.slug}`)]);
const equivalentPath = equivalentPages.has(path) ? path : "";
const englishHref = localizedHref("en", equivalentPath);
const chineseHref = localizedHref("zh", equivalentPath);
import { site } from "../data/site";
import Arrow from "../components/Arrow.astro";
import ArtistLogo from "../components/ArtistLogo.astro";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
}
const {
  title,
  description = site.description,
  active = "",
  image,
} = Astro.props;
const pageTitle = title
  ? `${title} — Xiyu Wang`
  : "Xiyu Wang — Sculptor, Tokyo";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage =
  image && Astro.site ? new URL(image, Astro.site).href : image;
const nav = [
  { label: "Works", href: href("works/") },
  { label: "About", href: href("about/") },
  { label: "CV", href: href("cv/") },
  { label: "Contact", href: href("contact/") },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: site.description,
  sameAs: [`https://www.instagram.com/${site.instagram}/`],
  workLocation: { "@type": "Place", name: "Tokyo, Japan" },
};
---

<!doctype html>
<html lang={language === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && equivalentPages.has(path) && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(englishHref, Astro.site)} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(chineseHref, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(englishHref, Astro.site)} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t("Skip to content")}
    </a>
    <header class="site-header signature-header page-gutter">
      <a href={href()} class="wordmark" aria-label={t("Xiyu Wang home")}>
        <ArtistLogo class="header-logo" />
        XIYU WANG
      </a>
      <button
        class="menu-toggle"
        data-menu-label={t("Menu")}
        data-close-label={t("Close")}
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t("Menu")}
        type="button"
      >
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
      </button>
      <div id="site-menu" class="navigation-panel" style={`--menu-last-index: ${nav.length + 1}`} aria-hidden="true" inert hidden>
      <nav
        id="main-navigation"
        class="main-navigation"
        aria-label={t("Main navigation")}
      >
        {nav.map((item, index) => (
          <a
            href={item.href}
            style={`--menu-index: ${index}`}
            aria-current={active === item.label ? "page" : undefined}
          >
            {t(item.label)}
          </a>
        ))}
      </nav>
      <div class="language-switcher" role="group" aria-label={t("Language")}>
        <a style={`--menu-index: ${nav.length}`} href={englishHref} lang="en" hreflang="en" aria-current={language === "en" ? "true" : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a style={`--menu-index: ${nav.length + 1}`} href={chineseHref} lang="zh-CN" hreflang="zh-CN" aria-current={language === "zh" ? "true" : undefined}>中文</a>
      </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer page-gutter">
      <a class="footer-name" href={href()}>
        <ArtistLogo class="footer-logo" loading="lazy" />
        XIYU WANG<span>{t("Sculptor")}, Tokyo</span>
      </a>
      <span class="copyright">© {new Date().getFullYear()} Xiyu Wang</span>
      <a
        class="footer-instagram"
        href={`https://www.instagram.com/${site.instagram}/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram <Arrow direction="diagonal" />
        <span class="sr-only"> {t("(opens in a new tab)")}</span>
      </a>
      <a class="back-top" href="#top" aria-label={t("Back to top")}>
        <Arrow direction="down" />
      </a>
    </footer>
    <script>
      import { initializeSiteMenu } from "../scripts/site-menu";
      initializeSiteMenu();
      document
        .querySelector(".back-top")
        ?.addEventListener("click", (event) => {
          event.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "instant"
              : "smooth",
          });
        });
    </script>
  </body>
</html>


<style>
  .signature-header {
    --signature-height: 120px;
    height: var(--signature-height);
    display: block;
    position: relative;
    z-index: 20;
    background: #fff;
    border: 0;
    box-shadow: none;
  }
  .signature-header .wordmark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .signature-header :global(.artist-logo.header-logo) {
    width: 72px;
    height: 42px;
    object-fit: contain;
  }
  .signature-header .menu-toggle {
    position: absolute;
    top: 50%;
    left: var(--gutter);
    right: auto;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
    margin: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .signature-header .menu-icon {
    position: relative;
    display: block;
    width: 24px;
    height: 16px;
  }
  .signature-header .menu-icon i {
    position: absolute;
    left: 0;
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease), top 0.25s var(--ease), opacity 0.2s ease-out;
    transform: none;
  }
  .signature-header .menu-icon i:nth-child(1) { top: 0; }
  .signature-header .menu-icon i:nth-child(2) { top: 7px; }
  .signature-header .menu-icon i:nth-child(3) { top: 14px; }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(2) {
    opacity: 0;
  }
  .signature-header .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }
  .signature-header .navigation-panel {
    position: absolute;
    top: 50%;
    left: calc(var(--gutter) + 60px);
    display: flex;
    align-items: center;
    gap: 24px;
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter) - 60px);
    transform: translateY(-50%);
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
    pointer-events: none;
  }
  .signature-header .navigation-panel[hidden] { display: none; }
  .signature-header .main-navigation {
    position: static;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
  }
  .signature-header .main-navigation > a {
    min-height: 44px;
    justify-content: flex-start;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: normal;
    white-space: nowrap;
  }
  .signature-header .main-navigation a::after { display: none; }
  .signature-header .main-navigation a:hover,
  .signature-header .main-navigation a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .signature-header .language-switcher {
    display: flex;
    justify-content: flex-start;
    gap: 6px;
    margin: 0;
    font-size: 12px;
  }
  .signature-header .language-switcher a { min-width: 32px; justify-content: center; }
  .signature-header .navigation-panel a,
  .signature-header .language-switcher > span {
    opacity: 0;
    transform: translateX(-18px);
    transition: opacity 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
      transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
    transition-delay: calc((var(--menu-last-index) - var(--menu-index, 4)) * 0.05s);
  }
  .signature-header.is-menu-open .navigation-panel a,
  .signature-header.is-menu-open .language-switcher > span {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(var(--menu-index, 4) * 0.05s);
  }
  .signature-header.is-menu-open .navigation-panel a { pointer-events: auto; }
  @media (max-width: 1199px) {
    .signature-header .navigation-panel {
      top: calc(50% + 28px);
      left: var(--gutter);
      transform: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
      max-width: calc(100vw - 2 * var(--gutter));
    }
    .signature-header .main-navigation {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .signature-header .main-navigation > a { font-size: 22px; }
    .signature-header .navigation-panel a,
    .signature-header .language-switcher > span { transform: translateY(-18px); }
    .signature-header.is-menu-open .navigation-panel a,
    .signature-header.is-menu-open .language-switcher > span { transform: translateY(0); }
  }
  .signature-header .menu-toggle:focus-visible,
  .signature-header a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .signature-header { --signature-height: 84px; }
    .signature-header .wordmark { font-size: 18px; gap: 10px; }
    .signature-header :global(.artist-logo.header-logo) { width: 48px; height: 28px; }
    .signature-header .menu-toggle { width: 44px; height: 44px; min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .signature-header .navigation-panel a,
    .signature-header .language-switcher > span,
    .signature-header .menu-icon i {
      transition: none;
    }
  }
  @media (max-width: 360px) {
    .signature-header .wordmark { font-size: 17px; gap: 8px; }
    .signature-header :global(.artist-logo.header-logo) { width: auto; height: 26px; }
  }
</style>
