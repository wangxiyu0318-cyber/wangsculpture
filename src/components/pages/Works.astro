---
import { getLanguage, translator } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import WorkItem from "../WorkItem.astro";
import { getProjects, projectPeriod } from "../../data/projects";

const language = getLanguage(Astro.url);
const t = translator(language);
const projects = getProjects(language);
const filters = [
  "All works",
  ...new Set(projects.map((project) => project.category).filter(Boolean)),
];
const years = [...new Set(projects.map((project) => project.year))]
  .sort((a, b) => Number(b) - Number(a));
const projectsByYear = years.map((year) => ({
  year,
  projects: projects.filter((project) => project.year === year),
}));
const total = String(projects.length).padStart(2, "0");
---

<Layout
  title={t("Works")}
  active="Works"
  description="A visual archive of sculpture in wood, metal, enamel, paper and mixed materials by Xiyu Wang, Tokyo."
>
  <section class="archive page-gutter" id="top" aria-labelledby="works-heading">
    <div class="page-heading">
      <span class="eyebrow">{t("Sculpture / Archive")}</span>
      <h1 id="works-heading">
        {t("Works")}<span class="heading-count">({total})</span>
      </h1>
    </div>
    <div class="archive-toolbar">
      <div class="filters" role="group" aria-label={t("Filter works by material")}>
        {filters.map((filter, i) => (
          <button data-filter={i === 0 ? "all" : filter} aria-pressed={i === 0} data-label={t(filter)}>
            {t(filter)}
            {i === 0 && <span>{total}</span>}
          </button>
        ))}
      </div>
      <span class="section-years">{projectPeriod}</span>
    </div>
    <p class="sr-only" id="filter-status" data-language={language} role="status" aria-live="polite">
      {language === "zh" ? `显示全部 ${projects.length} 件作品` : `Showing all ${projects.length} works`}
    </p>
    {projectsByYear.map((group) => (
      <section class="archive-year" data-year={group.year} aria-labelledby={`year-${group.year}`}>
        <h2 class="archive-year-heading eyebrow" id={`year-${group.year}`}>{group.year}</h2>
        <div class="archive-grid">
          {group.projects.map((project, i) => (
            <WorkItem
              project={project}
              number={String(projects.indexOf(project) + 1).padStart(2, "0")}
              class={`archive-work-${(i % 4) + 1}`}
              format={i % 4 === 1 ? "portrait" : "landscape"}
            />
          ))}
        </div>
      </section>
    ))}
  </section>
  <script>
    const filters =
      document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const works = document.querySelectorAll<HTMLElement>(
      ".archive-grid .work-item",
    );
    filters.forEach((button) =>
      button.addEventListener("click", () => {
        const selected = button.dataset.filter;
        filters.forEach((filter) =>
          filter.setAttribute("aria-pressed", String(filter === button)),
        );
        let count = 0;
        works.forEach((work) => {
          work.hidden =
            selected !== "all" && work.dataset.material !== selected;
          if (!work.hidden) count++;
        });
        document.querySelectorAll<HTMLElement>(".archive-year").forEach((group) => {
          group.hidden = !Array.from(group.querySelectorAll<HTMLElement>(".work-item"))
            .some((work) => !work.hidden);
          group.querySelector(".archive-grid")
            ?.classList.toggle("is-filtered", selected !== "all");
        });
        const status = document.querySelector<HTMLElement>("#filter-status");
        if (status)
          status.textContent = status.dataset.language === "zh"
            ? `显示 ${count} 件作品${selected === "all" ? "" : `（${button.dataset.label}）`}`
            : `Showing ${count} ${count === 1 ? "work" : "works"}${selected === "all" ? "" : ` in ${selected}`}`;
      }),
    );
  </script>
</Layout>

<style>
  .archive-year + .archive-year {
    margin-top: 90px;
  }
  .archive-year-heading {
    color: var(--muted);
    margin-bottom: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 700px) {
    .archive-year + .archive-year {
      margin-top: 60px;
    }
    .archive-year-heading {
      margin-bottom: 24px;
      font-size: 12px;
    }
  }
</style>
