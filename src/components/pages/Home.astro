---
import { getLanguage, translator, localizedHref } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import Artwork from "../Artwork.astro";
import Arrow from "../Arrow.astro";
import { getProjects } from "../../data/projects";
import { materials } from "../../data/materials";

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const projects = getProjects(language);
const representativeSlugs = [
  "somira", "four-gates-pagoda", "nezhas-bike", "cave", "minira", "stonesomira",
];
const positions = ["left", "right", "inset", "center", "right", "left"];
const representativeWorks = representativeSlugs.map((slug) => {
  const project = projects.find((project) => project.slug === slug);
  if (!project?.images[0]) throw new Error(`Missing representative work or cover: ${slug}`);
  return project;
});
---

<Layout>
  <section class="home-intro page-gutter curated-home" id="top" aria-labelledby="artist-name">
    <div class="home-heading">
      <h1 id="artist-name">XIYU WANG</h1>
      <div class="home-location">
        <span>{t("Sculptor")}</span>
        <span>Tokyo, Japan <span class="location-point" aria-hidden="true"></span></span>
      </div>
    </div>
    <div class="curated-sequence" role="group" aria-label={t("Selected works")}>
      {representativeWorks.map((project, index) => (
        <>
        <article
          class:list={["curated-work", `curated-work-${positions[index]}`, { "curated-work-portrait": project.images[0].width < project.images[0].height }]}
          style={`grid-row: ${index + Math.floor(index / 2) + 1}`}
        >
          <a href={href(`works/${project.slug}/`)}>
            <figure>
              <Artwork
                image={project.images[0]}
                eager={index === 0}
                sizes="(max-width: 700px) 86vw, (max-width: 1500px) 46vw, 680px"
              />
              <figcaption>
                <div class="curated-title">
                  <h2>{project.title}</h2>
                </div>
                <p>{project.year} · {project.materials}</p>
              </figcaption>
            </figure>
          </a>
        </article>
        {index % 2 === 1 && (
          <div
            class:list={["material-entrance", `material-entrance-${materials[Math.floor(index / 2)].id}`]}
            style={`grid-row: ${index + Math.floor(index / 2) + 2}`}
          >
            <a href={`${href("works/")}?material=${materials[Math.floor(index / 2)].id}`}>
              {t(materials[Math.floor(index / 2)].entrance)} <Arrow />
            </a>
          </div>
        )}
        </>
      ))}
    </div>
    <div class="archive-entrance">
      <a class="text-link" href={href("works/")}>{t("View all works")} <Arrow /></a>
      <a class="text-link" href={href("about/")}>{t("About the artist")} <Arrow /></a>
    </div>
  </section>
</Layout>

<style>
  .curated-home {
    padding-bottom: 80px;
  }
  .home-heading {
    margin-bottom: 80px;
    align-items: flex-end;
  }
  .home-heading h1 {
    font-size: clamp(48px, 7.4vw, 112px);
    font-weight: 325;
    line-height: 1.08;
    letter-spacing: 0.005em;
    margin-left: 0;
  }
  .curated-sequence {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: clamp(88px, 8vw, 120px);
    padding-block: 8px 80px;
  }
  .curated-work {
    width: 100%;
    max-width: 680px;
    min-width: 0;
  }
  .curated-work-left {
    grid-column: 1 / 7;
    justify-self: start;
  }
  .curated-work-right {
    grid-column: 7 / 13;
    justify-self: end;
  }
  .curated-work-inset,
  .curated-work-center {
    grid-column: 4 / 10;
    justify-self: center;
  }
  .curated-work-portrait {
    width: 92%;
    max-width: 640px;
  }
  .curated-work a {
    display: block;
  }
  .curated-work :global(img) {
    width: 100%;
    height: auto;
  }
  .curated-work figcaption {
    padding-top: 14px;
  }
  .curated-title h2 {
    overflow-wrap: anywhere;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: normal;
  }
  .curated-work figcaption p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .material-entrance {
    grid-column: 4 / 10;
    justify-self: start;
    margin-block: -24px;
  }
  .material-entrance-wood {
    grid-column: 7 / 13;
  }
  .material-entrance-metal {
    grid-column: 1 / 7;
  }
  .material-entrance a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 400;
    letter-spacing: 0.025em;
  }
  .material-entrance :global(.arrow) {
    width: 18px;
    height: 18px;
  }
  .archive-entrance {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px 48px;
  }
  .archive-entrance .text-link {
    min-height: 44px;
  }
  @media (max-width: 700px) {
    .curated-home {
      padding-bottom: 48px;
    }
    .home-heading {
      margin-bottom: 40px;
    }
    .home-heading h1 {
      font-size: clamp(32px, 9.7vw, 62px);
    }
    .curated-sequence {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
      padding-block: 0 48px;
    }
    .curated-work {
      grid-column: 1;
      width: 86vw;
      max-width: 100%;
    }
    .curated-work figcaption p {
      font-size: 13px;
    }
    .material-entrance {
      grid-column: 1;
      margin: -8px 0;
    }
    .material-entrance a {
      font-size: 22px;
      gap: 12px;
    }
  }
</style>
