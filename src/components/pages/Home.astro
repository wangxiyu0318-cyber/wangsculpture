---
import { getLanguage, translator, localizedHref } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import Artwork from "../Artwork.astro";
import ArtworkPlaceholder from "../ArtworkPlaceholder.astro";
import WorkItem from "../WorkItem.astro";
import Arrow from "../Arrow.astro";
import { getProjects, projectPeriod } from "../../data/projects";

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const projects = getProjects(language);
const featured = {
  hero: "somira",
  selected: ["four-gates-pagoda", "cave", "minira"],
};
function getFeaturedProject(slug: string) {
  const project = projects.find((project) => project.slug === slug);
  if (!project) throw new Error(`Unknown featured project: ${slug}`);
  return project;
}
const hero = getFeaturedProject(featured.hero);
const total = String(projects.length).padStart(2, "0");
---

<Layout>
  <section
    class="home-intro page-gutter"
    id="top"
    aria-labelledby="artist-name"
  >
    <div class="home-heading">
      <h1 id="artist-name">XIYU WANG</h1>
      <div class="home-location">
        <span>{t("Sculptor")}</span>
        <span>
          Tokyo, Japan <span class="location-point" aria-hidden="true"></span>
        </span>
      </div>
    </div>
    <a
      class="hero-artwork"
      href={href(`works/${hero.slug}/`)}
      aria-label={`View ${hero.title}`}
    >
      {hero.images[0] ? (
        <Artwork
          image={hero.images[0]}
          class={hero.slug === "somira" ? "somira-cover" : undefined}
          eager
          sizes="(max-width: 700px) 100vw, calc(100vw - 96px)"
        />
      ) : (
        <ArtworkPlaceholder title={hero.title} format="hero" />
      )}
      <span class="hero-view">
        {t("Explore the work")} <Arrow direction="diagonal" />
      </span>
    </a>
    <div class="hero-caption">
      <div>
        <span class="caption-index">01 / {total}</span>
        <span>
          {hero.title}
          {hero.year && `, ${hero.year}`}
        </span>
      </div>
      {hero.materials && <span class="hero-material">{hero.materials}</span>}
      <a href="#selected-works" class="explore-link">
        {t("Scroll to explore")} <Arrow direction="down" />
      </a>
    </div>
  </section>
  <section
    class="selected-section page-gutter"
    id="selected-works"
    aria-labelledby="selected-heading"
  >
    <div class="section-heading">
      <h2 id="selected-heading">
        {t("Selected works")} <span class="count">(03)</span>
      </h2>
      <span class="section-years">{projectPeriod}</span>
      <a class="text-link" href={href("works/")}>
        {t("View all works")} <Arrow />
      </a>
    </div>
    <div class="selected-grid">
      <WorkItem
        project={getFeaturedProject(featured.selected[0])}
        number="02"
        class="selected-one"
        format="portrait"
      />
      <WorkItem project={getFeaturedProject(featured.selected[1])} number="03" class="selected-two" />
      <WorkItem project={getFeaturedProject(featured.selected[2])} number="04" class="selected-three" />
    </div>
  </section>
  <section class="home-about page-gutter">
    <span class="eyebrow">{t("The artist")}</span>
    <div>
      <h2>Xiyu Wang</h2>
      <p>Sculptor based in Tokyo, Japan.</p>
      <a href={href("about/")} class="text-link">
        {t("About the artist")} <Arrow />
      </a>
    </div>
  </section>
</Layout>
