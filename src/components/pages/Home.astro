---
import { getLanguage, translator, localizedHref } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import Artwork from "../Artwork.astro";
import Arrow from "../Arrow.astro";
import ArtistLogo from "../ArtistLogo.astro";
import { getProjects } from "../../data/projects";
import { materials } from "../../data/materials";

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const projects = getProjects(language);
const representativeSlugs = [
  "somira", "four-gates-pagoda", "nezhas-bike", "cave", "minira", "stonesomira",
];
const positions = ["left", "right", "inset", "center", "right", "left"];
const representativeWorks = representativeSlugs.map((slug) => {
  const project = projects.find((project) => project.slug === slug);
  if (!project?.images[0]) throw new Error(`Missing representative work or cover: ${slug}`);
  return project;
});
---

<Layout>
  <section class="home-intro page-gutter curated-home" id="top" aria-labelledby="artist-name">
    <div class="home-heading">
      <h1 id="artist-name">XIYU WANG</h1>
      <div class="home-location">
        <span>{t("Sculptor")}</span>
        <span>Tokyo, Japan <span class="location-point" aria-hidden="true"></span></span>
      </div>
    </div>
    <div class="home-signature">
      <ArtistLogo class="signature-logo" />
    </div>
    <div class="curated-sequence" role="group" aria-label={t("Selected works")}>
      {representativeWorks.map((project, index) => (
        <>
        <article
          class:list={["curated-work", `curated-work-${positions[index]}`]}
          style={`--work-width: ${project.images[0].width / project.images[0].height < 0.9 ? 38 : project.images[0].width / project.images[0].height > 1.2 ? 48 : 43}vw`}
        >
          <a href={href(`works/${project.slug}/`)}>
            <figure>
              <Artwork
                image={project.images[0]}
                eager={index === 0}
                sizes="(max-width: 700px) 86vw, (max-width: 1500px) 48vw, 720px"
              />
              <figcaption>
                <div class="curated-title">
                  <h2>{project.title}</h2>
                </div>
                <p>{project.year} · {project.materials}</p>
              </figcaption>
            </figure>
          </a>
        </article>
        {index % 2 === 1 && (
          <div class:list={["material-entrance", `material-entrance-${materials[Math.floor(index / 2)].id}`]}>
            <a href={`${href("works/")}?material=${materials[Math.floor(index / 2)].id}`}>
              {t(materials[Math.floor(index / 2)].entrance)} <Arrow />
            </a>
          </div>
        )}
        </>
      ))}
    </div>
    <div class="archive-entrance">
      <a class="text-link" href={href("works/")}>{t("View all works")} <Arrow /></a>
      <a class="text-link" href={href("about/")}>{t("About the artist")} <Arrow /></a>
    </div>
  </section>
</Layout>

<style>
  .curated-home {
    padding-bottom: 80px;
  }
  .home-heading {
    margin-bottom: 32px;
    align-items: flex-end;
  }
  .home-heading h1 {
    font-size: clamp(58px, 9vw, 136px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin-left: 0;
  }
  .home-signature {
    display: flex;
    justify-content: flex-end;
    padding-inline: 4%;
    margin-block: 16px 40px;
  }
  .curated-sequence {
    display: flex;
    flex-direction: column;
    gap: clamp(100px, 9vw, 160px);
    padding-block: 16px 80px;
  }
  .curated-work {
    width: min(var(--work-width), 720px);
    max-width: 92%;
    min-width: 0;
  }
  .curated-work-left {
    align-self: flex-start;
    margin-left: 4%;
  }
  .curated-work-right {
    align-self: flex-end;
    margin-right: 4%;
  }
  .curated-work-inset {
    align-self: flex-start;
    margin-left: 12%;
  }
  .curated-work-center {
    align-self: center;
  }
  .curated-work a {
    display: block;
  }
  .curated-work :global(img) {
    width: 100%;
    height: auto;
  }
  .curated-work figcaption {
    padding-top: 14px;
  }
  .curated-title h2 {
    overflow-wrap: anywhere;
    font-size: 15px;
    font-weight: 450;
    letter-spacing: -0.01em;
  }
  .curated-work figcaption p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .material-entrance {
    align-self: center;
    margin-block: -36px;
  }
  .material-entrance-wood {
    margin-left: 24%;
  }
  .material-entrance-metal {
    margin-right: 24%;
  }
  .material-entrance a {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    font-size: clamp(24px, 2.4vw, 36px);
    font-weight: 400;
    letter-spacing: 0.025em;
  }
  .material-entrance :global(.arrow) {
    width: 20px;
    height: 20px;
  }
  .archive-entrance {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px 48px;
  }
  .archive-entrance .text-link {
    min-height: 44px;
  }
  @media (max-width: 700px) {
    .curated-home {
      padding-bottom: 48px;
    }
    .home-heading {
      margin-bottom: 24px;
    }
    .home-heading h1 {
      font-size: clamp(38px, 11.8vw, 76px);
    }
    .home-signature {
      margin-block: 8px 28px;
      padding-inline: 0;
    }
    .curated-sequence {
      gap: 48px;
      padding-block: 8px 48px;
    }
    .curated-work {
      width: 86vw;
      max-width: 100%;
      margin-inline: 0;
    }
    .curated-title h2 {
      font-size: 15px;
    }
    .curated-work figcaption p {
      font-size: 13px;
    }
    .material-entrance {
      margin: -8px 0;
    }
    .material-entrance a {
      font-size: 24px;
      gap: 12px;
    }
    .material-entrance :global(.arrow) {
      width: 18px;
      height: 18px;
    }
  }
</style>
