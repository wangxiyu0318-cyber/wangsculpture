---
import { getLanguage, translator, localizedHref } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../ProjectGallery.astro";
import ArtworkPlaceholder from "../ArtworkPlaceholder.astro";
import Arrow from "../Arrow.astro";
import { getProjects } from "../../data/projects";

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const projects = getProjects(language);
interface Props { slug: string; }
const { slug } = Astro.props;
const index = projects.findIndex((project) => project.slug === slug);
if (index < 0) throw new Error(`Unknown project: ${slug}`);
const project = projects[index];
const next = projects[(index + 1) % projects.length];
const number = (value: number) => String(value).padStart(2, "0");
const cover = project.images[0];
---

<Layout
  title={project.title}
  active="Works"
  description={[
    project.title,
    "Xiyu Wang",
    project.year,
    project.materials,
    project.description,
  ]
    .filter(Boolean)
    .join(". ")}
  image={cover ? `${import.meta.env.BASE_URL}images/${cover.src}.webp` : undefined}
>
  <article class="project page-gutter" id="top">
    <a class="back-link" href={href("works/")}>
      <Arrow /> {t("All works")}
    </a>
    <header class="project-heading">
      <div>
        <span class="eyebrow">
          {t("Project")}{project.year && ` · ${project.year}`}
        </span>
        <h1>{project.title}</h1>
      </div>
      <span class="project-index">
        {number(index + 1)} / {number(projects.length)}
      </span>
    </header>
    <div class="project-gallery">
      {cover ? (
        <ProjectGallery images={project.images} media={project.media} title={project.title} />
      ) : (
        <div class="primary-figure">
          <ArtworkPlaceholder title={project.title} />
        </div>
      )}
      <div class:list={["project-details", { "metadata-only": !project.description }]}>
        <dl>
          <div>
            <dt>{t("Year")}</dt>
            <dd>{project.year || "To be added"}</dd>
          </div>
          <div>
            <dt>{t("Materials")}</dt>
            <dd>{project.materials || "To be added"}</dd>
          </div>
          <div>
            <dt>{t("Dimensions")}</dt>
            <dd style={project.dimensions.includes("\n") ? "white-space: pre-line;" : undefined}>{project.dimensions || "To be added"}</dd>
          </div>
        </dl>
        {project.description && (
          <div class="project-description">
            <p style={project.description.includes("\n") ? "white-space: pre-line;" : undefined}>
              {project.description}
            </p>
          </div>
        )}
      </div>

    </div>
    <a class="next-project" href={href(`works/${next.slug}/`)}>
      <span class="eyebrow">{t("Next work")}</span>
      <span class="next-title">{next.title}</span>
      <Arrow />
    </a>
  </article>
</Layout>
