---
import { getLanguage, translator, localizedHref } from "../../i18n";
import { projectDescription } from "../../lib/seo";
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../ProjectGallery.astro";
import ArtworkPlaceholder from "../ArtworkPlaceholder.astro";
import Arrow from "../Arrow.astro";
import { getProjects } from "../../data/projects";

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string = "") => localizedHref(language, path);
const projects = getProjects(language);
interface Props { slug: string; }
const { slug } = Astro.props;
const index = projects.findIndex((project) => project.slug === slug);
if (index < 0) throw new Error(`Unknown project: ${slug}`);
const project = projects[index];
const next = projects[(index + 1) % projects.length];
const number = (value: number) => String(value).padStart(2, "0");
const cover = project.images[0];
---

<Layout
  title={project.title}
  active="Works"
  description={projectDescription(project, language)}
  image={cover ? `${import.meta.env.BASE_URL}images/${cover.src}.webp` : undefined}
>
  <article class="project page-gutter" id="top">
    <a class="back-link" href={href("works/")}>
      <Arrow /> {t("All works")}
    </a>
    <header class="project-heading">
      <div>
        <span class="eyebrow">
          {t("Project")}{project.year && ` · ${project.year}`}
        </span>
        <h1>{project.title}</h1>
      </div>
      <span class="project-index">
        {number(index + 1)} / {number(projects.length)}
      </span>
    </header>
    <div class="project-gallery">
      {cover ? (
        <ProjectGallery images={project.images} media={project.media} title={project.title} />
      ) : (
        <div class="primary-figure">
          <ArtworkPlaceholder title={project.title} />
        </div>
      )}
      <div class:list={["project-details", { "metadata-only": !project.description }]}>
        <dl>
          <div>
            <dt>{t("Year")}</dt>
            <dd>{project.year || "To be added"}</dd>
          </div>
          <div>
            <dt>{t("Materials")}</dt>
            <dd>{project.materials || "To be added"}</dd>
          </div>
          <div>
            <dt>{t("Dimensions")}</dt>
            <dd style={project.dimensions.includes("\n") ? "white-space: pre-line;" : undefined}>{project.dimensions || "To be added"}</dd>
          </div>
        </dl>
        {project.description && (
          <div class="project-description">
            <p style={project.description.includes("\n") ? "white-space: pre-line;" : undefined}>
              {project.description}
            </p>
          </div>
        )}
      </div>

    </div>
    <a class="next-project" href={href(`works/${next.slug}/`)}>
      <span class="eyebrow">{t("Next work")}</span>
      <span class="next-title">{next.title}</span>
      <Arrow />
    </a>
  </article>
</Layout>

<style>
  .project .project-heading {
    margin-block: clamp(30px, 3.5vw, 45px) clamp(35px, 4vw, 50px);
    gap: 24px;
  }
  .project .project-heading > div { min-width: 0; }
  .project .project-heading h1 {
    max-width: 24ch;
    font-size: clamp(40px, 4.8vw, 70px);
    line-height: 1.15;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  .project .project-index {
    flex-shrink: 0;
    padding-bottom: 4px;
  }
  .project .project-details {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.55fr);
    gap: clamp(32px, 5vw, 72px);
    padding-block: 0;
    margin-top: clamp(45px, 5vw, 65px);
    margin-bottom: clamp(70px, 8vw, 100px);
    border-bottom: 0;
  }
  .project .project-details > * { min-width: 0; }
  .project .project-details dl {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .project .project-details dl > div {
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 16px;
    margin-bottom: 0;
    font-size: 14px;
    line-height: 1.75;
  }
  .project .project-details dt { color: var(--muted); }
  .project .project-details dd {
    color: var(--ink);
    overflow-wrap: break-word;
  }
  .project .project-description { max-width: 60ch; }
  .project .project-description > p {
    font-size: 16px;
    line-height: 1.8;
  }
  .project .project-details.metadata-only {
    grid-template-columns: minmax(0, 1fr);
  }
  .project .project-details.metadata-only dl { max-width: 740px; }
  .project .next-project {
    margin-top: 0;
    padding-top: clamp(24px, 3vw, 35px);
  }
  @media (max-width: 700px) {
    .project .project-heading { gap: 12px; align-items: flex-start; }
    .project .project-heading h1 { font-size: clamp(32px, 7vw, 44px); }
    .project .project-details {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .project .project-details dl > div {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
