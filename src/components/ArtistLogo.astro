---
interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}
const { class: className, loading = "eager" } = Astro.props;
---
<img
  class:list={["artist-logo", className]}
  src={`${import.meta.env.BASE_URL}logo.png`}
  width="3000"
  height="1750"
  alt=""
  aria-hidden="true"
  loading={loading}
  decoding="async"
/>
