---
import Artwork from "./Artwork.astro";
import Arrow from "./Arrow.astro";
import type { ArtworkImage, ArtworkMedia } from "../data/projects";
import { getLanguage, translator } from "../i18n";
interface Props { images: ArtworkImage[]; media?: ArtworkMedia[]; title: string; }
const { images, media, title } = Astro.props;
const items = media ?? images;
const cover = images[0];
if (!cover || !items.length || items[0].type === "video" || items[0].src !== cover.src) {
  throw new Error("Project galleries must start with the still cover image.");
}
const multiple = items.length > 1;
const hasVideo = items.some((item) => item.type === "video");
const t = translator(getLanguage(Astro.url));
const imageData = JSON.stringify(items).replace(/</g, "\\u003c");
---
<figure
  class="project-figure primary-figure inline-gallery"
  data-inline-gallery
  data-title={title}
  data-video-label={t("Video")}
  data-base={import.meta.env.BASE_URL}
  tabindex={multiple ? 0 : undefined}
  role="group"
  aria-label={`${title} ${t(hasVideo ? "media viewer" : "image viewer")}`}
>
  <div class="inline-gallery-stage" data-gallery-stage>
    <Artwork image={cover} eager sizes="(max-width: 700px) 100vw, 90vw" />
    {hasVideo && (
      <video data-gallery-video hidden controls preload="metadata" playsinline>
        {t("Your browser does not support HTML5 video.")}
      </video>
    )}
    {multiple && (
      <>
        <button type="button" class="gallery-control gallery-previous" data-gallery-previous aria-label={t(hasVideo ? "Previous media" : "Previous image")} disabled><Arrow /></button>
        <button type="button" class="gallery-control gallery-next" data-gallery-next aria-label={t(hasVideo ? "Next media" : "Next image")}><Arrow /></button>
      </>
    )}
  </div>
  <figcaption aria-live="polite" aria-atomic="true">
    <span data-gallery-caption>{items[0].caption ?? ""}</span>
    <span data-gallery-count>01 / {String(items.length).padStart(2, "0")}</span>
  </figcaption>
  {multiple && <script type="application/json" data-gallery-images set:html={imageData} />}
</figure>
<script>
  import { initializeProjectGalleries } from "../scripts/project-gallery";
  initializeProjectGalleries();
</script>
<style>
  .inline-gallery {
    width: 100%;
    margin-inline: 0;
  }
  .inline-gallery:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 5px;
  }
  .inline-gallery-stage {
    position: relative;
    width: 100%;
    height: clamp(360px, 70vh, 880px);
  }
  .inline-gallery-stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: contain;
  }
  .inline-gallery-stage :global([hidden]) { display: none; }
  .inline-gallery-stage video {
    position: absolute;
    top: 0;
    left: 56px;
    width: calc(100% - 112px);
    height: 100%;
    object-fit: contain;
  }
  .inline-gallery > figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px 24px;
    margin-top: 14px;
    padding-inline: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
  [data-gallery-caption] {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  [data-gallery-caption]:empty { display: none; }
  [data-gallery-count] {
    margin-left: auto;
    flex-shrink: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .gallery-control:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .inline-gallery-stage:has(.gallery-control) {
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }
  .gallery-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .gallery-previous { left: 8px; }
  .gallery-next { right: 8px; }
  .gallery-previous :global(.arrow) { transform: rotate(180deg); }
  .gallery-control :global(.arrow) { width: 18px; height: 18px; }
  .gallery-control:disabled { visibility: hidden; }
  @media (max-width: 700px) {
    .inline-gallery-stage {
      height: clamp(280px, 63vh, 620px);
      height: clamp(280px, 63svh, 620px);
    }
    .inline-gallery-stage video { left: 46px; width: calc(100% - 92px); }
    .gallery-previous { left: 2px; }
    .gallery-next { right: 2px; }
    .gallery-control :global(.arrow) { width: 16px; height: 16px; }
  }
</style>
