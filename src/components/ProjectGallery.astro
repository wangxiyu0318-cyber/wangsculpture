---
import Artwork from "./Artwork.astro";
import Arrow from "./Arrow.astro";
import type { ArtworkImage } from "../data/projects";
import { getLanguage, translator } from "../i18n";
interface Props { images: ArtworkImage[]; title: string; }
const { images, title } = Astro.props;
const cover = images[0];
const multiple = images.length > 1;
const t = translator(getLanguage(Astro.url));
const imageData = JSON.stringify(images).replace(/</g, "\\u003c");
---
<figure
  class="project-figure primary-figure inline-gallery"
  data-inline-gallery
  data-base={import.meta.env.BASE_URL}
  tabindex={multiple ? 0 : undefined}
  role="group"
  aria-label={`${title} ${t("image viewer")}`}
>
  <div class="inline-gallery-stage" style={`aspect-ratio: ${cover.width} / ${cover.height}`} data-gallery-stage>
    <Artwork image={cover} eager sizes="(max-width: 700px) 100vw, 90vw" />
    {multiple && (
      <>
        <button type="button" class="gallery-control gallery-previous" data-gallery-previous aria-label={t("Previous image")} disabled><Arrow /></button>
        <button type="button" class="gallery-control gallery-next" data-gallery-next aria-label={t("Next image")}><Arrow /></button>
      </>
    )}
  </div>
  <figcaption aria-live="polite" aria-atomic="true">
    <span data-gallery-caption>{cover.caption}</span>
    <span data-gallery-count>01 / {String(images.length).padStart(2, "0")}</span>
  </figcaption>
  {multiple && <script type="application/json" data-gallery-images set:html={imageData} />}
</figure>
<script>
  import { initializeProjectGalleries } from "../scripts/project-gallery";
  initializeProjectGalleries();
</script>
<style>
  .inline-gallery:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 5px;
  }
  .inline-gallery-stage {
    position: relative;
    width: 100%;
    max-height: 900px;
  }
  .inline-gallery-stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: contain;
  }
  .inline-gallery-stage:has(.gallery-control) {
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }
  .gallery-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .gallery-previous { left: 8px; }
  .gallery-next { right: 8px; }
  .gallery-previous :global(.arrow) { transform: rotate(180deg); }
  .gallery-control :global(.arrow) { width: 18px; height: 18px; }
  .gallery-control:disabled { visibility: hidden; }
  @media (max-width: 700px) {
    .inline-gallery-stage { max-height: none; }
    .gallery-previous { left: 2px; }
    .gallery-next { right: 2px; }
    .gallery-control :global(.arrow) { width: 16px; height: 16px; }
  }
</style>
